rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo gli utenti creati dall'amministratore possono leggere e scrivere.
    // La registrazione autonoma va disattivata in Authentication.
    match /{collezione}/{documento} {
      allow read, write: if request.auth != null
        && collezione in ['progetti', 'collaboratori', 'presenze', 'impostazioni', 'utenti'];
    }
  }
}
